{ pkgs, lib, config, ... }:

{
  # Runtime
  virtualisation.podman = {
    enable = true;
    autoPrune.enable = true;
    dockerCompat = true;
  };

  # Enable container name DNS for all Podman networks.
  networking.firewall.interfaces = let
    matchAll = if !config.networking.nftables.enable then "podman+" else "podman*";
  in {
    "${matchAll}".allowedUDPPorts = [ 53 ];
  };

  virtualisation.oci-containers.backend = "podman";

  # Containers
  virtualisation.oci-containers.containers."bitmagnet" = {
    image = "ghcr.io/bitmagnet-io/bitmagnet:latest";
    environment = {
      "POSTGRES_HOST" = "10.90.0.10";
      "POSTGRES_PASSWORD" = "postgres";
    };
    volumes = [
      "/home/dallas/bitmagnet/config:/root/.config/bitmagnet:rw"
    ];
    ports = [
      "3333:3333/tcp"
      "3334:3334/tcp"
      "3334:3334/udp"
    ];

    # Disable, or enable dht_crawler
#    cmd = [ "worker" "run" "--keys=http_server" "--keys=queue_server" "--keys=dht_crawler" ];
    cmd = [ "worker" "run" "--keys=http_server" "--keys=queue_server" ];

    dependsOn = [
      "bitmagnet-postgres"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=bitmagnet"
      "--network=bitmagnet_default"
    ];
  };
  systemd.services."podman-bitmagnet" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container bitmagnet generated by compose2nix.";
    after = [
      "podman-network-bitmagnet_default.service"
    ];
    requires = [
      "podman-network-bitmagnet_default.service"
    ];
    partOf = [
      "podman-compose-bitmagnet-root.target"
    ];
    wantedBy = [
      "podman-compose-bitmagnet-root.target"
    ];
  };
  virtualisation.oci-containers.containers."bitmagnet-postgres" = {
    image = "postgres:16-alpine";
    environment = {
      "PGUSER" = "postgres";
      "POSTGRES_DB" = "bitmagnet";
      "POSTGRES_PASSWORD" = "postgres";
    };
    volumes = [
      "/home/dallas/bitmagnet/data/postgres:/var/lib/postgresql/data:rw"
    ];
    log-driver = "journald";
    extraOptions = [
      "--health-cmd=pg_isready"
      "--health-interval=10s"
      "--health-start-period=20s"
      "--network-alias=postgres"
      "--network=bitmagnet_default"
      "--ip=10.90.0.10"                 # new: fixed address
      "--shm-size=1073741824"
    ];
  };
  systemd.services."podman-bitmagnet-postgres" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container bitmagnet-postgres generated by compose2nix.";
    after = [
      "podman-network-bitmagnet_default.service"
    ];
    requires = [
      "podman-network-bitmagnet_default.service"
    ];
    partOf = [
      "podman-compose-bitmagnet-root.target"
    ];
    wantedBy = [
      "podman-compose-bitmagnet-root.target"
    ];
  };

  # Networks
  systemd.services."podman-network-bitmagnet_default" = {
    unitConfig.Description = "Network bitmagnet_default generated by compose2nix.";
    path = [ pkgs.podman ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f bitmagnet_default";
    };
    script = ''
      podman network inspect bitmagnet_default || \
        podman network create --disable-dns --subnet 10.90.0.0/24 bitmagnet_default
    '';
    partOf = [ "podman-compose-bitmagnet-root.target" ];
    wantedBy = [ "podman-compose-bitmagnet-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-bitmagnet-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };

  networking.firewall.allowedTCPPorts = [
    3333
    3334
  ];

  networking.firewall.allowedUDPPorts = [
    3334
  ];
}
